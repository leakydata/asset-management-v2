# Secrets — never commit
.env
.env.*
!.env.example
local.settings.json

# Caterpillar Confidential source documents — do not publish (esp. to a public repo)
data/

# Claude Code — local agent config, skills, settings
.claude/
CLAUDE.local.md

# Node dependencies — restore with: cd powerpoints && npm install
node_modules/

# Generated decks — rebuild from powerpoints/build_*.js (source is tracked)
powerpoints/*.pptx
powerpoints/*.pdf

# Manim intermediate render cache — regenerated on every render.
# NOTE: decision_key.py, audio/, check*.png and final.mp4 stay tracked —
# build_snowflake_deck.js embeds ../manim/final.mp4, so ignoring it would
# make the main deck unbuildable from a fresh clone.
manim/media/
manim/__pycache__/

# Python
__pycache__/
*.pyc
.venv/
venv/

# uv
.uv/
